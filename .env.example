# Copy to .env at the repository root. Never commit .env.

APP_ENV=development
APP_NAME=Challenge

DATABASE_URL=postgresql+asyncpg://challenge:challenge@localhost:5432/challenge
TEST_DATABASE_URL=postgresql+asyncpg://challenge:challenge@localhost:5432/challenge_test

# At least 32 characters. Used to sign the development and Telegram sessions.
SECRET_KEY=replace-with-a-random-string-at-least-32-characters
SESSION_TTL_SECONDS=86400

# Required to run the bot and to accept real Mini App logins.
# Development browser login works without it. Production refuses to start without it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
WEBAPP_URL=http://localhost:3000

INIT_DATA_MAX_AGE_SECONDS=86400
INIT_DATA_CLOCK_SKEW_SECONDS=30

CORS_ORIGINS=http://localhost:3000

POSTGRES_USER=challenge
POSTGRES_PASSWORD=challenge
POSTGRES_DB=challenge

# Read by the Next.js app from this file. Not a secret.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Verify.et confirms Telebirr deposits. Register webhook:
#   {WEBAPP_URL}/api/webhooks/verify-et
# Save the whsec_ secret once. Withdrawals stay manual (admin complete/reject).
VERIFY_ET_BASE_URL=https://verify.et
VERIFY_ET_API_KEY=
VERIFY_ET_WEBHOOK_SECRET=
# Starting Telebirr account shown to players. Change both later from /admin.
TELEBIRR_ACCOUNT_NAME=Naol Kecha
TELEBIRR_SETTLEMENT_ACCOUNT=
# Header X-Admin-Key for /admin. Required to change the account and confirm cash outs.
ADMIN_API_KEY=
